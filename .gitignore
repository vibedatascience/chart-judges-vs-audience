# Whitelist: ignore everything, then allow only what the project needs.
*
!*/
!.gitignore
!README.md
!LOG.md
!requirements.txt
!notes/*.md
!src/*.py
!src/*.sh
!pairs/*.parquet
!data/clean/*.parquet
!judges/raw/*.jsonl
!judges/parsed/*.csv
!analysis/*.csv
!analysis/*.md
!analysis/*.log
!figures/*.png
!figures/*.pdf
!figures/gallery/*.jpg
!figures/gallery/coding.html
!paper/main_anon.tex
!paper/main_camera.tex
!paper/main.tex
!paper/supplement.tex
!paper/refs.bib
!paper/vgtc.cls
!paper/*.bst
!paper/figs/*.pdf
!paper/main_anon.pdf
!paper/main_camera.pdf
!paper/supplement.pdf
# never commit these even if a pattern above matches
lib/
tools/
data/raw/
data/vis_csv/
data/vis_images/
data/images_std/
judges/cache/
figures/qa/
